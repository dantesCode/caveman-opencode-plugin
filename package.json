{
  "name": "caveman-opencode-plugin",
  "version": "0.1.5",
  "description": "Caveman communication mode plugin for opencode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/index.v2.d.ts",
      "import": "./dist/index.v2.js"
    },
    "./*": "./*"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun run build.ts && tsc --emitDeclarationOnly",
    "dev": "opencode plugin dev",
    "setup": "bun run src/setup.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.21",
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.21",
    "@opencode/plugin": "^2.0.22",
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  },
  "keywords": ["opencode", "plugin", "caveman"],
  "author": "renux918",
  "license": "MIT"
}
